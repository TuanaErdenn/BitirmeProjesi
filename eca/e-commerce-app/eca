#!/bin/bash

# Check if enough arguments are provided
if [ $# -lt 2 ]; then
    echo "Usage: $0 <environment> <action>"
    echo "Example: $0 dev up"
    echo "Example: $0 dev down"
    exit 1
fi

ENVIRONMENT=$1
ACTION=$2

case $ENVIRONMENT in
    "dev")
        case $ACTION in
            "up")
                echo "Starting development environment..."
                docker compose -f docker/dev.yaml up -d
                ;;
            "down")
                echo "Stopping development environment..."
                docker compose -f docker/dev.yaml down
                ;;
            *)
                echo "Unknown action: $ACTION"
                echo "Available actions: up, down"
                exit 1
                ;;
        esac
        ;;
    "prod")
        case $ACTION in
            "up")
                echo "Starting production environment..."
                docker compose -f docker/prod.yaml up -d --build
                ;;
            "down")
                echo "Stopping production environment..."
                docker compose -f docker/prod.yaml down
                ;;
            *)
                echo "Unknown action: $ACTION"
                echo "Available actions: up, down"
                exit 1
                ;;
        esac
        ;;
    *)
        echo "Unknown environment: $ENVIRONMENT"
        echo "Available environments: dev, prod"
        exit 1
        ;;
esac